# Copy to .env.local for local development. Never commit real values.
# In Netlify: Site configuration > Environment variables.

NEXT_PUBLIC_SITE_URL=
HYDREIGHT_BOOKING_URL=
CONTACT_EMAIL=

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# Stripe (test keys until her account is approved)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Mailchimp public signup form (no API key). All values are public and already the
# defaults in src/lib/constants.ts; set these only if Shary's form changes.
# NEXT_PUBLIC_MAILCHIMP_DC=us22
# NEXT_PUBLIC_MAILCHIMP_U=7887c318e6740cc303be74a3f
# NEXT_PUBLIC_MAILCHIMP_ID=485dcfa742
# NEXT_PUBLIC_MAILCHIMP_F_ID=00a1c2e1f0
# NEXT_PUBLIC_MAILCHIMP_SOURCE_TAG=SOURCE   # merge tag of her "where they signed up" text field
# NEXT_PUBLIC_MAILCHIMP_OPTIN_TAG=OPTIN     # merge tag of her "ticked the email box" text field

# Future Hydreight automation stub
HYDREIGHT_HOOK_SECRET=

# Optional
# NEXT_PUBLIC_HIDE_TODOS=1   # hides the dashed TODO boxes. Set for production once every TODO is resolved.

# Testing only. Leave empty everywhere except the Playwright config.
# STRIPE_API_BASE=
