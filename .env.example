# Copy to .env.local for local development. Never commit real values.
# In Netlify: Site configuration > Environment variables.

NEXT_PUBLIC_SITE_URL=
HYDREIGHT_BOOKING_URL=
CONTACT_EMAIL=
NOTIFY_EMAIL=

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# Stripe (test keys until her account is approved)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Mailchimp
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# Form notification emails (only if Resend is chosen)
RESEND_API_KEY=
# Booking follow-up email. Sender on a domain verified in Resend. Unset = no follow-up.
FOLLOWUP_FROM=
# FOLLOWUP_DELAY_MINUTES=60   # testing only: lower it to get the email sooner

# Future Hydreight automation stub
HYDREIGHT_HOOK_SECRET=

# Optional
# RESEND_FROM=           # sender once a domain is verified in Resend, e.g. "Avida Luna <hello@avidaluna.com>"
# NEXT_PUBLIC_HIDE_TODOS=1   # hides the dashed TODO boxes. Set for production once every TODO is resolved.

# Testing only. Leave empty everywhere except the Playwright config.
# STRIPE_API_BASE=
# MAILCHIMP_API_BASE=
# RESEND_API_BASE=
